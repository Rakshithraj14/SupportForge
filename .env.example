# PostgreSQL (external — you supply this)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/supportforge

# Same credentials, decomposed — docker-compose uses these to rebuild DATABASE_URL
# with host.docker.internal instead of localhost for the backend/celery containers
# (Postgres is external/host-native, same reason OLLAMA_BASE_URL gets swapped too).
# The password must be URL-encoded (e.g. "@" -> "%40") since it's substituted
# directly into a connection URL.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
POSTGRES_DB=supportforge

# Qdrant (runs in docker-compose)
QDRANT_URL=http://localhost:6333

# Ollama (native on host, not containerized)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Langfuse (cloud.langfuse.com — optional, tracing no-ops if unset)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Redis (Celery broker/backend — runs in docker-compose)
REDIS_URL=redis://localhost:6379/0
