# PostgreSQL (external — you supply this)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/supportforge

# Qdrant (runs in docker-compose)
QDRANT_URL=http://localhost:6333

# Ollama (native on host, not containerized)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Redis (Celery broker/backend — runs in docker-compose)
REDIS_URL=redis://localhost:6379/0
